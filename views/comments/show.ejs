<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Comment Details</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f1f5f9;
        padding: 40px 20px;
      }

      .container {
        max-width: 650px;
        margin: auto;
      }

      .header {
        text-align: center;
        background: #2563eb;
        color: white;
        padding: 25px;
        border-radius: 12px 12px 0 0;
      }

      .card {
        background: white;
        padding: 30px;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
      }

      .comment-id {
        background: #dbeafe;
        color: #2563eb;
        padding: 8px 15px;
        border-radius: 20px;
        display: inline-block;
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 25px;
      }

      .label {
        color: #94a3b8;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 8px;
      }

      .username {
        font-size: 22px;
        color: #1e293b;
        margin-bottom: 25px;
      }

      .comment-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 20px;
        border-radius: 10px;
        color: #475569;
        line-height: 1.7;
        margin-bottom: 30px;
      }

      .buttons {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
      }

      .btn {
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        color: white;
        font-size: 14px;
        border: none;
        cursor: pointer;
        text-align: center;
      }

      .edit {
        background: #2563eb;
      }

      .edit:hover {
        background: #1d4ed8;
      }

      .delete {
        background: #dc2626;
      }

      .delete:hover {
        background: #b91c1c;
      }

      .back {
        display: block;
        text-align: center;
        color: #64748b;
        text-decoration: none;
        margin-top: 20px;
      }

      .back:hover {
        color: #2563eb;
      }

      @media (max-width: 500px) {
        .buttons {
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>Comment Details</h1>
        <p>View your comment information</p>
      </div>

      <div class="card">
        <div class="comment-id">Comment ID: <%= comment.id %></div>

        <div class="label">USERNAME</div>

        <h2 class="username"><%= comment.username %></h2>

        <div class="label">COMMENT</div>

        <div class="comment-box"><%= comment.comment %></div>

        <div class="buttons">
          <a class="btn edit" href="/comments/<%= comment.id %>/edit">
            ✎ Edit Comment
          </a>

          <form
            method="POST"
            action="/comments/<%= comment.id %>?_method=DELETE"
          >
            <button class="btn delete">Delete Comment</button>
          </form>
        </div>

        <a class="back" href="/comments"> ← Back to Comments </a>
      </div>
    </div>
  </body>
</html>
