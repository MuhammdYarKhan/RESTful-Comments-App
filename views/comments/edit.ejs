<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Comment</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f1f5f9;
        padding: 40px 20px;
      }

      .container {
        max-width: 650px;
        margin: auto;
      }

      .header {
        background: #2563eb;
        color: white;
        text-align: center;
        padding: 25px;
        border-radius: 12px 12px 0 0;
      }

      .card {
        background: white;
        padding: 30px;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
      }

      .label {
        display: block;
        color: #475569;
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 12px;
      }

      textarea {
        width: 100%;
        min-height: 160px;
        padding: 15px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        font-family: Arial, sans-serif;
        font-size: 15px;
        line-height: 1.6;
        resize: vertical;
        outline: none;
        margin-bottom: 20px;
      }

      textarea:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px #dbeafe;
      }

      .buttons {
        display: flex;
        gap: 12px;
      }

      .btn {
        padding: 12px 22px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-size: 14px;
        text-decoration: none;
        text-align: center;
      }

      .save {
        background: #2563eb;
        color: white;
      }

      .save:hover {
        background: #1d4ed8;
      }

      .cancel {
        background: #e2e8f0;
        color: #334155;
      }

      .cancel:hover {
        background: #cbd5e1;
      }

      @media (max-width: 500px) {
        .buttons {
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>Edit Comment</h1>
        <p>Update your comment below</p>
      </div>

      <div class="card">
        <form method="POST" action="/comments/<%= comment.id %>?_method=PATCH">
          <label class="label"> Your Comment </label>

          <textarea name="comment" required><%= comment.comment %></textarea>

          <div class="buttons">
            <button class="btn save">Save Changes</button>

            <a href="/comments/<%= comment.id %>" class="btn cancel">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
